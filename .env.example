# Strict policy mode is hardcoded in app runtime.
# Toggle fallback only if you have a worker implementing:
# POST /jobs and GET /jobs/:jobId
ENABLE_FALLBACK=false
FALLBACK_WORKER_URL=

# Quotas / safety caps
FALLBACK_MAX_JOBS_PER_IP_PER_DAY=5
FALLBACK_MAX_ESTIMATED_SIZE_MB=350
FALLBACK_JOB_TTL_MINUTES=30
FALLBACK_POLL_TIMEOUT_MS=4500

# Only enable if you configure COOP/COEP correctly for your full deployment
ENABLE_COOP_COEP=false
